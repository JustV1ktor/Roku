<component name="ActionLoader" extends = "Group">  
    <children>

        <LayoutGroup
            translation = "[960, 540]"
            horizAlignment = "center"
            vertAlignment = "center">
            <Rectangle
                width = "1920"
                height = "1080"
                color = "0x31304088"/>
        </LayoutGroup>
        
        <LayoutGroup
            id = "mainArea"
            translation = "[960, 540]"
            horizAlignment = "center"
            vertAlignment = "center"
            layoutDirection = "horiz"
            itemSpacings = "[20]">
            <Rectangle
                id = "firstRectangle"
                color = "0xffffff"
                width = "30"
                height = "70"/>
