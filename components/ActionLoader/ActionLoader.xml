                color = "0xffffff"
                width = "30"
                height = "70"/>
        </LayoutGroup>

        <SequentialAnimation
            id = "firstRectangleAnimation">
            <Animation 
                duration = "1"
                repeat = "true"
                easeFunction="linear">
                <FloatFieldInterpolator 
                    key = "[0.0,0.5,1.0]"
                    keyValue = "[70.0, 140.0, 70.0]" 
                    fieldToInterp = "firstRectangle.height"/>            
            </Animation>
        </SequentialAnimation>

        <SequentialAnimation
            id = "secondRectangleAnimation">
