<component name="HomeView" extends="Group">
    <interface>
        <field id="userData" type="assocarray"/>
        <field id="showContentListView" type="boolean"/>
        <field id="showCustomKeyGridView" type="boolean" />
        <field id="showSlideShowView" type="boolean" />
        <field id="isLoading" type="boolean" />
        <field id="isUserLogedOut" type="boolean" />
    </interface>

    <children>
        <LayoutGroup
            id = "mainArea"
            horizAlignment = "center"
            vertAlignment = "center"
            translation = "[960, 540]"
            layoutDirection = "vert">
            <Label
                text = "Home"/>
            <LayoutGroup
                layoutDirection = "horiz">
                <Label
                    text = "Your name is: "/>
                <Label
                    id = "userName"/>
            </LayoutGroup>
            <LayoutGroup
                layoutDirection = "horiz">
                <Label
                    text = "Your nickname is: "/>
                <Label
                    id = "userNickName"/>
            </LayoutGroup>
            <LayoutGroup
                layoutDirection = "horiz">
                <Label
                    text = "Your email is: "/>
                <Label
                    id = "userEmail"/>
            </LayoutGroup>
            <LayoutGroup
                layoutDirection = "horiz">
                <Label
                    text = "Your Password is: "/>
                <TextEditBox
                    secureMode = "true"
                    id = "userPassword"/>
            </LayoutGroup>
            <LayoutGroup
                id = "buttonGroup">
                <Button
                    text = "show Content list"
                    id = "buttonShowContentListView"/>
                <Button
                    text = "show CustomKey Grid"
                    id = "buttonShowCustomKeyGridView"/>
                <Button
                    text = "show Slide Show"
                    id = "buttonShowSlideShowView"/>
                <Button
                    text = "Log out of account"
                    id = "buttonLogOut"/>
            </LayoutGroup>
        </LayoutGroup>
    </children>

    <script type="text/brightscript" uri="HomeView.brs" />
</component>