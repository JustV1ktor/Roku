<component name="ContentListView" extends = "Group">
    <interface>
        <field id="isLoading" type="boolean" />
        <field id="showPlayerScreenViewFromContent" type="boolean" />
        <field id="videoUrl" type="string" />
    </interface>
    
    <children>
        <LayoutGroup
            layoutDirection = "vert"
            horizAlignment = "left"
            vertAlignment = "top"
            translation = "[10, 10]">
            <LayoutGroup 
                id = "topElments"
                layoutDirection = "horiz"
                itemSpacings = "[10]">
                    <Poster
                    id = "poster"
                    loadDisplayMode = "scaleToFit"
                    loadWidth = "950"
                    loadHeight = "530"/>
                    <LayoutGroup
                        layoutDirection = "vert"
                        itemSpacings = "[20]">
                        <Label
                        id = "title"
                        maxLines = "2"
                        wrap = "true"
                        font = "font:LargeSystemFont"/>
                        <Rectangle
                            id = "devider"
                            color = "0xffffffff"
                            height = "2"/>
                        <Label
                        id = "description"
                        wrap = "true"/>
                            <layoutGroup
                                layoutDirection = "horiz"
                                itemSpacings = "[20]">
                                <Label
                                id = "averageRating"/>
                                <Label
                                id = "releaseDate"/>
                            </layoutGroup>
                    </LayoutGroup>
            </LayoutGroup>
            <LayoutGroup 
                id = "bottomElments">
                <RowList
                    id = "rowList"
                    itemComponentName = "RowListItem" 
                    rowFocusAnimationStyle = "floatingFocus"
                    vertFocusAnimationStyle = "floatingFocus"
                    variableWidthItems = "[ true ]"
                    showRowLabel = "[ true ]"
                    showRowCounter = "[ true ]"
                    rowLabelOffset = "[ [0, 20] ]"
                    numRows = "1"
                    itemSize = "[1880, 470]"
                    rowItemSize = "[[265,400]]"
                    rowItemSpacing = "[ [50, 0] ]">
                </RowList>
            </LayoutGroup>
        </LayoutGroup>
    </children>

    <script type="text/brightscript" uri="ContentListView.brs"/>
    <script type="text/brightscript" uri="../ActionResponse/ActionResponse.brs"/>
</component>
