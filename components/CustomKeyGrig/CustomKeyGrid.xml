<component name="CustomKeyGrid" extends="Group">
    <children>
        <LayoutGroup
            translation = "[960, 540]"
            horizAlignment = "center"
            vertAlignment = "center">
            <TextEditBox
                id = "textEditBox"/>
            <LayoutGroup
                id = "customKeyArea"
                horizAlignment = "center"
                layoutDirection = "vert">
            </LayoutGroup>
            <LayoutGroup
                id = "controlKeyArea"
                horizAlignment = "center"
                layoutDirection = "vert">
                <Button
                    id = "buttonClear"
                    text = "clear"/>
                <Button
                    id = "buttonSpace"
                    text = "space"/>
                <Button
                    id = "buttonEnter"
                    text = "enter"/>
            </LayoutGroup>
        </LayoutGroup>  
    </children>

    <script type="text/brightscript" uri="CustomKeyGrid.brs" />
    <script type="text/brightscript" uri="../ActionResponse/ActionResponse.brs" />
</component>