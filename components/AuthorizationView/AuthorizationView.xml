<component name="AuthorizationView" extends="Group">
    <interface>
        <field id="isLoginSuccess" type="boolean" />
        <field id="isLoading" type="boolean" />
    </interface>
    
    <children>
        <LayoutGroup
            id = "mainArea"
            translation = "[960, 540]"
            horizAlignment = "center"
            vertAlignment = "center">
            <TextEditBox
                id = "emailTextEditBox"
                focusable = "true"
                hintText = "email"
                clearOnDownKey = "false"/>
            <TextEditBox
                id = "passwordTextEditBox"
                focusable = "true"
                hintText = "password"
                secureMode = "true"
                clearOnDownKey = "false"/>
            <Button
                id = "buttonAuthorization"
                text = "sign in!"/>
        </LayoutGroup>
    </children>

    <script type="text/brightscript" uri="AuthorizationView.brs" />
    <script type="text/brightscript" uri="../ActionResponse/ActionResponse.brs"/>
</component>
